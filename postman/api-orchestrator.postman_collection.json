        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"inventoryNumber\": \"inv-postman-001\",\r\n  \"name\": \"Postman Router\",\r\n  \"model\": \"RTX-1\",\r\n  \"location\": \"Lab-1\"\r\n}",
          "options": {
