    {
      "name": "8) Отправить команду роутеру",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });\r",
              "let json = {}; try { json = pm.response.json(); } catch (e) {}\r",
              "pm.test('Response has commandIds', function () {\r",
              "  pm.expect(json).to.have.property('commandIds');\r",
              "});\r",
              "if (json && Array.isArray(json.commandIds) && json.commandIds.length > 0) pm.collectionVariables.set('commandId', json.commandIds[0]);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"routerId\": \"{{routerId}}\",\r\n  \"commandType\": \"PING\",\r\n  \"payload\": \"{}\"\r\n}",
