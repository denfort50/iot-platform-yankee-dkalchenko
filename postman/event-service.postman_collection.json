{
  "info": {
    "_postman_id": "35e42502-aa45-4b37-be48-919e080f55f5",
    "name": "event-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "48910547",
