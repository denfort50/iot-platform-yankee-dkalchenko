        "url": {
          "raw": "{{event_service_url}}/api/v1/events/3ba1f2ae-2161-4f1b-b651-a3d3b29ea0f8?deviceId=device-17687879",
          "host": [
            "{{event_service_url}}"
          ],
          "path": [
            "api",
            "v1",
            "events",
            "3ba1f2ae-2161-4f1b-b651-a3d3b29ea0f8"
          ],
          "query": [
            {
              "key": "deviceId",
              "value": "device-17687879"
            }
          ]
        }
      },
      "response": []
    }
