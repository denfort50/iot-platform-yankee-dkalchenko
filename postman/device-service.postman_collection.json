  },
  "item": [
    {
      "name": "0) Получить токен тестового пользователя",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });\r",
              "let json = {}; try { json = pm.response.json(); } catch (e) {}\r",
              "pm.test('Response has tokens', function () {\r",
              "  pm.expect(json).to.have.property('access_token');\r",
              "  pm.expect(json).to.have.property('refresh_token');\r",
              "});\r",
              "if (json && json.access_token) pm.collectionVariables.set('access_token', json.access_token);\r",
              "if (json && json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "grant_type=password&client_id=admin-cli&username=device-api-user&password=device-api-password",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{keycloak_url}}/realms/master/protocol/openid-connect/token",
          "host": [
            "{{keycloak_url}}"
          ],
          "path": [
            "realms",
            "master",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      },
      "response": []
    },
    {
      "name": "1) Создать устройство",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('202 Accepted', function () { pm.response.to.have.status(202); });\r",
              "let json = {}; try { json = pm.response.json(); } catch (e) {}\r",
              "pm.test('Response has deviceId', function () {\r",
              "  pm.expect(json).to.have.property('deviceId');\r",
              "});\r",
              "if (json && json.deviceId) pm.collectionVariables.set('deviceId', json.deviceId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"deviceType\": \"something\",\r\n  \"meta\": \"new test device\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{device-service_lb_url}}/v1/devices",
          "host": [
            "{{device-service_lb_url}}"
          ],
          "path": [
            "v1",
            "devices"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2) Прочитать устройство",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{device-service_lb_url}}/v1/devices/{{deviceId}}",
          "host": [
            "{{device-service_lb_url}}"
          ],
          "path": [
            "v1",
            "devices",
            "{{deviceId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3) Обновить устройство",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"deviceType\": \"electro\",\r\n  \"meta\": \"any meta info\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{device-service_lb_url}}/v1/devices/{{deviceId}}",
          "host": [
            "{{device-service_lb_url}}"
          ],
          "path": [
            "v1",
            "devices",
            "{{deviceId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4) Удалить устройство",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{device-service_lb_url}}/v1/devices/{{deviceId}}",
          "host": [
            "{{device-service_lb_url}}"
          ],
          "path": [
            "v1",
            "devices",
            "{{deviceId}}"
          ]
        }
      },
      "response": []
    }
  ],
