{
  "info": {
    "_postman_id": "b6711266-7135-4c59-96ca-1b6bb28f7398",
    "name": "device-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "48910547",
