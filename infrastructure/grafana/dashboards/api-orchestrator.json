  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "iteration": 1776643200001,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "HTTP (public API)",
      "type": "row"
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Business RPS",
      "description": "Запросы к /devices*, /commands*, /events* (исключая actuator).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\"}[$__rate_interval]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Error RPS (4xx + 5xx)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\",status=~\"4..|5..\"}[$__rate_interval]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "5xx RPS",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\",status=~\"5..\"}[$__rate_interval]))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "continuous-GrYlRd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "P95 latency",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\"}[$__rate_interval])))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "continuous-RdYlGr" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "RPS by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "P95 latency by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": "$datasource",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"api-orchestrator\",uri=~\"/devices.*|/commands.*|/events.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
