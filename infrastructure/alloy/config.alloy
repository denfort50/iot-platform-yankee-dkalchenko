loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "host"
    replacement  = constants.hostname
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.metrics.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "metrics" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Отдельный discovery для events-collector-service: скрапим каждый инстанс по IP в сети,
// чтобы в Prometheus попадали метрики со всех реплик (sum по инстансам даёт полное число событий).
discovery.relabel "events_collector" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = ".*events-collector-service.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = ".*iot-platform-net.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex         = "(.+)"
    target_label  = "__address__"
    replacement   = "${1}:9090"
  }

  rule {
    target_label = "__metrics_path__"
    replacement  = "/actuator/prometheus"
  }

  rule {
    target_label = "job"
    replacement  = "events-collector-service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "instance"
    replacement   = "${1}:9090"
  }
}

// Discovery для device-collector-service: скрапим по IP в сети, путь /actuator/prometheus, порт 9090.
discovery.relabel "device_collector" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = ".*device-collector-service.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_name"]
    regex         = ".*iot-platform-net.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex         = "(.+)"
    target_label  = "__address__"
    replacement   = "${1}:9090"
  }

  rule {
    target_label = "__metrics_path__"
    replacement  = "/actuator/prometheus"
  }

  rule {
    target_label = "job"
    replacement  = "device-collector-service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "instance"
    replacement   = "${1}:9090"
  }
}

prometheus.scrape "docker_services" {
  scrape_interval = "15s"

  targets = [
    { __address__ = "keycloak:9000", __metrics_path__ = "/metrics", job = "keycloak" },
    { __address__ = "grafana:3000", __metrics_path__ = "/metrics", job = "grafana" },
    { __address__ = "alloy:9080", __metrics_path__ = "/metrics", job = "alloy" },
    { __address__ = "loki:3100", __metrics_path__ = "/metrics", job = "loki" },
    { __address__ = "tempo:3200", __metrics_path__ = "/metrics", job = "tempo" },
    { __address__ = "keycloak-postgres-exporter:9187", __metrics_path__ = "/metrics", job = "keycloak-postgres" },
    { __address__ = "camunda-postgres-exporter:9187", __metrics_path__ = "/metrics", job = "camunda-postgres" },
    { __address__ = "iot-platform-postgres-exporter-shard0:9187", __metrics_path__ = "/metrics", job = "iot-platform-postgres", instance = "shard0" },
    { __address__ = "iot-platform-postgres-exporter-shard1:9187", __metrics_path__ = "/metrics", job = "iot-platform-postgres", instance = "shard1" },
    { __address__ = "iot-platform-postgres-exporter-shard2:9187", __metrics_path__ = "/metrics", job = "iot-platform-postgres", instance = "shard2" },
    { __address__ = "kafka-exporter:9308", __metrics_path__ = "/metrics", job = "kafka" },
    { __address__ = "redis-exporter:9121", __metrics_path__ = "/metrics", job = "redis" },
    { __address__ = "minio:9000", __metrics_path__ = "/minio/v2/metrics/cluster", job = "minio" },
    { __address__ = "clickhouse:9363", __metrics_path__ = "/metrics", job = "clickhouse" },
  ]

  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "events_collector" {
  scrape_interval = "10s"
  targets         = discovery.relabel.events_collector.output
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

prometheus.scrape "device_collector" {
  scrape_interval = "10s"
  targets         = discovery.relabel.device_collector.output
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}

// HTTP health probing for schema-registry via blackbox exporter (/subjects, every 10s)
prometheus.exporter.blackbox "schema_registry" {
  // Minimal inline config: single http_2xx module with 5s timeout
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "schema-registry"
    address = "http://schema-registry:8081/subjects"
    module  = "http_2xx"
    labels = {
      service = "schema-registry",
    }
  }
}

prometheus.scrape "schema_registry_health" {
  scrape_interval = "10s"
  targets         = prometheus.exporter.blackbox.schema_registry.targets
  forward_to      = [prometheus.remote_write.prometheus.receiver]
}