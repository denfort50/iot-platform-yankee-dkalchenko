# Kafka & Schema Registry
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9093,kafka3:9094
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Clickhouse configuration
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/clickhouse?compress=0
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=admin

# PostgreSQL и ShardingSphere
DEVICE_COLLECTOR_POSTGRES_USER=admin
DEVICE_COLLECTOR_POSTGRES_PASSWORD=admin
# Внутри Docker-сети шарды слушают порт 5432; 5436/5437/5438 — только для доступа с хоста
POSTGRESQL_DS0_URL=jdbc:postgresql://postgres-shard0:5432/iot_platform_shard0?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS0_REPLICA_URL=jdbc:postgresql://postgres-shard0:5432/iot_platform_shard0?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS1_URL=jdbc:postgresql://postgres-shard1:5432/iot_platform_shard1?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS1_REPLICA_URL=jdbc:postgresql://postgres-shard1:5432/iot_platform_shard1?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS2_URL=jdbc:postgresql://postgres-shard2:5432/iot_platform_shard2?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS2_REPLICA_URL=jdbc:postgresql://postgres-shard2:5432/iot_platform_shard2?currentSchema=collector&options=-c%20search_path%3Dcollector,pg_catalog,public
POSTGRESQL_DS0_USER=admin
POSTGRESQL_DS0_PASSWORD=admin
POSTGRESQL_DS1_USER=admin
POSTGRESQL_DS1_PASSWORD=admin
POSTGRESQL_DS2_USER=admin
POSTGRESQL_DS2_PASSWORD=admin
POSTGRESQL_DS0_REPLICA_USER=admin
POSTGRESQL_DS0_REPLICA_PASSWORD=admin
POSTGRESQL_DS1_REPLICA_USER=admin
POSTGRESQL_DS1_REPLICA_PASSWORD=admin
POSTGRESQL_DS2_REPLICA_USER=admin
POSTGRESQL_DS2_REPLICA_PASSWORD=admin

# Nexus configuration (для сборки образов сервисов — передаётся в build args)
NEXUS_URL=http://host.docker.internal:8082/repository/maven-releases/
NEXUS_USER=admin
NEXUS_PASSWORD=admin

# Grafana Alloy configuration
ALLOY_USER=root

# Grafana configuration
GRAFANA_ADMIN_USER=grafana_user
GRAFANA_ADMIN_PASSWORD=grafana_password

# Camunda configuration
CAMUNDA_POSTGRES_USER=camunda
CAMUNDA_POSTGRES_PASSWORD=camunda

# OTLP traces (events-collector-service)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces

# MinIO credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123

# Keycloak credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=keycloak
