@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(engineer, "Инженер", "Управляет устройствами и просматривает события через UI/API")

System_Ext(device, "IoT-устройства", "Маршрутизаторы, отправляющие телеметрию в Kafka")

System_Boundary(system, "IoT Microservice Platform") {
    Container_Boundary(iot, "IoT Core") {
        ContainerDb(iot_pg, "IoT Platform Postgres", "PostgreSQL 17", "Основная реляционная БД платформы")
        Container(ecs, "Events Collector Service", "Spring Boot", "Консьюмер необработанных событий из Kafka")
        Container(pg_exp_iot, "Postgres Exporter (IoT)", "postgres-exporter", "Экспорт метрик IoT Platform Postgres")
        Container(redis_exp_iot, "Redis Exporter", "redis-exporter", "Экспорт метрик Redis")
        Container(redis, "Redis", "Redis", "Кэш и in-memory хранилище")
        ContainerDb(clickhouse, "ClickHouse", "ClickHouse", "Хранилище аналитических и временных рядов")
        Container(minio, "MinIO", "S3-compatible Object Storage", "Объектное хранилище файлов и данных")
    }
    Container_Boundary(iam, "Keycloak IAM") {
        Container_Ext(keycloak, "Keycloak", "Java / Quarkus", "IAM: аутентификация и авторизация")
        ContainerDb_Ext(keycloak_pg, "Keycloak Postgres", "PostgreSQL 17", "База данных Keycloak")
        Container_Ext(pg_exp_keycloak, "Postgres Exporter (Keycloak)", "postgres-exporter", "Экспорт метрик Postgres Keycloak")
    }
    Container_Boundary(camunda_bpm, "Camunda BPM") {
        Container_Ext(camunda, "Camunda BPM", "Java", "Workflow и BPM движок")
        ContainerDb_Ext(camunda_pg, "Camunda Postgres", "PostgreSQL 17", "База данных Camunda")
        Container_Ext(pg_exp_camunda, "Postgres Exporter (Camunda)", "postgres-exporter", "Экспорт метрик Postgres Camunda")
    }
    Container_Boundary(kafka_cluster, "Kafka Cluster") {
        Container_Ext(kafka1, "Kafka Broker 1", "Apache Kafka", "Брокер сообщений")
        Container_Ext(kafka2, "Kafka Broker 2", "Apache Kafka", "Брокер сообщений")
        Container_Ext(kafka3, "Kafka Broker 3", "Apache Kafka", "Брокер сообщений")
    }
    Container_Boundary(obs, "Observability Platform") {
        Container_Ext(prometheus, "Prometheus", "Prometheus", "Сбор и хранение метрик")
        Container_Ext(grafana, "Grafana", "Grafana", "Визуализация метрик, логов и трейсов")
        Container_Ext(loki, "Loki", "Grafana Loki", "Хранилище логов")
        Container_Ext(tempo, "Tempo", "Grafana Tempo", "Хранилище распределённых трейсов")
        Container_Ext(alloy, "Grafana Alloy", "OTel Collector", "Сбор логов, метрик и трейсов")
        Container_Ext(redis_insight, "Redis Insight", "Web UI", "Веб-консоль мониторинга Redis")
        Container_Ext(kafka_ui, "Kafka UI", "Web UI", "Веб-интерфейс управления Kafka")
    }

    Container_Ext(kafka_exporter, "Kafka Exporter", "kafka-exporter", "Экспорт метрик Kafka-кластера")
    Container_Ext(schema_registry, "Schema Registry", "Confluent", "Управление Avro схемами")
}

Rel(device, kafka_cluster, "Сырые данные складируются в кластер Kafka", "Kafka Protocol")
Rel(kafka_cluster, ecs, "Сырые данные отправляются в сервис-коллектор", "Kafka Protocol")
Rel(ecs, redis, "Дедупликация сырых данных", "TCP/IP")
Rel(ecs, clickhouse, "Обработанные данные сохраняются в БД", "JDBC")
Rel(ecs, kafka_cluster, "Обработанные данные складируются в Kafka", "Kafka Protocol")

Rel(engineer, grafana, "Просматривает метрики, логи и трейсы", "HTTP")
Rel(engineer, kafka_ui, "Администрирует Kafka", "HTTP")
Rel(engineer, keycloak, "Управляет пользователями и ролями", "HTTP")
Rel(engineer, redis_insight, "Контролирует Redis", "HTTP")
Rel(engineer, minio, "Управляет объектным хранилищем", "HTTP")
Rel(engineer, camunda_bpm, "Управляет workflow", "HTTP")

Rel(keycloak, keycloak_pg, "Читает и записывает данные", "JDBC")
Rel(camunda, camunda_pg, "Читает и записывает данные", "JDBC")

Rel(kafka_cluster, kafka_ui, "Визуализация брокера")
Rel(schema_registry, kafka_ui, "Визуализация реестра схем")
Rel(kafka_cluster, kafka_exporter, "Отправка метрик брокера")
Rel(schema_registry, kafka_cluster, "Отправка Avro-схем", "Kafka Protocol")
Rel(kafka_exporter, alloy, "Отправка метрик кластера Kafka", "HTTP")

Rel(iot_pg, pg_exp_iot, "Метрики БД отправляются через экспортёра")
Rel(keycloak_pg, pg_exp_keycloak, "Метрики БД отправляются через экспортёра")
Rel(camunda_pg, pg_exp_camunda, "Метрики БД отправляются через экспортёра")

Rel(redis, redis_exp_iot, "Метрики кэша отправляются через экспортёра", "TCP/IP")

Rel(pg_exp_iot, alloy, "Метрики БД", "HTTP")
Rel(pg_exp_keycloak, alloy, "Метрики БД", "HTTP")
Rel(pg_exp_camunda, alloy, "Метрики БД", "HTTP")

Rel(redis_exp_iot, alloy, "Метрики кэша", "HTTP")
Rel(iot, alloy, "Логи идут через агента", "HTTP")

Rel(alloy, loki, "Логи отправляются в Loki", "HTTP")
Rel(alloy, tempo, "Трейсы отправляются в Tempo", "OTLP/gRPC")
Rel(alloy, prometheus, "Метрики отправляются в Prometheus", "OTLP/HTTP")

Rel(prometheus, grafana, "Визуализация метрик", "HTTP")
Rel(loki, grafana, "Визуализация логов", "HTTP")
Rel(tempo, grafana, "Визуализация трейсов", "HTTP")

Rel(redis, redis_insight, "Визуализация кэша", "HTTP/RESP")

@enduml
