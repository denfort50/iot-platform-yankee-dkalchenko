@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container_Ext(kafka, "Kafka", "Очереди событий", "events.v1, devices.v1")
Container_Ext(schema_registry, "Schema Registry", "Confluent", "Хранение Avro схем")
Container(redis, "Redis", "In-memory DB", "Кэш для проверки дубликатов и распределенных блокировок")
Container(ch, "ClickHouse", "OLAP база данных", "Хранит события и Outbox таблицу")

Container_Boundary(eventsCollector, "Events Collector Service", "Spring Boot", "Сервис получает события и сохраняет их") {
    Component(eventListener, "Event Listener", "Слушает сообщения с событиями из топика events.v1")
    Component(eventService, "Event Service", "Выполняет бизнес-логику обработки событий")
    Component(eventRepository, "Event Repository", "Обеспечивает CRUD операции сырых событий в Clickhouse")
    Component(outboxRepository, "Outbox Repository", "Обеспечивает CRUD операции обработанных событий в Clickhouse")
    Component(deduplicationService, "Deduplication Service", "Выполняет бизнес-логику дедупликации событий")
    Component(redisClient, "Redis Client", "Взаимодействует с Redis")
    Component(outboxProcessor, "Outbox Processor", "Управляет отправкой событий в целевой топик Kafka")
    Component(instanceRegistry , "Instance Registry", "Реестр экземпляров сервиса")
    Component(devicePublisher, "Device Publisher", "Публикует устройства в devices.v1 топик Kafka")
}

Rel(kafka, eventListener, "Передает сырые события")
Rel(eventListener, schema_registry, "Десериализует события по схемам Avro")
Rel(eventListener, eventService, "Передает сырое событие на обработку")
Rel(eventService, eventRepository, "Передает сырое событие на сохранение в БД")
Rel(eventRepository, ch, "Вставка в основную таблицу сырых событий")
Rel(eventService, deduplicationService, "Передает device_id на дедупликацию")
Rel(deduplicationService, redisClient, "Дедуплицирует device_id")
Rel(redisClient, redis, "Проверка ID на предмет наличия дубликата / сохранение ID")
Rel(eventService, outboxRepository, "Передает данные для сохранения в таблицу Outbox")
Rel(outboxRepository, ch, "Вставка данных в Outbox таблицу")
Rel(outboxProcessor, instanceRegistry, "Взаимодействует с реестром инстансов сервиса для определения диапазона записей на отправку")
Rel(instanceRegistry, redisClient, "Передает данные клиенту Redis")
Rel(redisClient, redis, "Сохраняет/сверяет данные об инстансах сервиса в Redis")
Rel(outboxProcessor, outboxRepository, "Запрашивает записи на слое персистенции")
Rel(outboxRepository, ch, "Запрашивает записи из БД для отправки в Kafka")
Rel(outboxProcessor, devicePublisher, "Передает данные на отправку в Kafka")
Rel(devicePublisher, kafka, "Отправляет outbox записи в Kafka")

@enduml
