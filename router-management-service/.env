# Local run: same vars as in infrastructure/docker-compose for router-management-service.
# Postgres: use Docker (infrastructure) — port 5439 on host.
# If using local Postgres: POSTGRES_HOST=localhost, POSTGRES_PORT=5432.

GRPC_PORT=50051
HTTP_PORT=8091
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_USER=router_mgmt
POSTGRES_PASSWORD=router_mgmt
POSTGRES_DB=router_management
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/1 * * * *
SENT_TIMEOUT_MINUTES=1
AUTH_ENABLED=true
KEYCLOAK_ISSUER_URI=http://host.docker.internal:8080/realms/master
AUTH_CLIENT_ID=admin-cli